<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bilihl">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 必须声明 targetSdkVersion：缺失时系统按 targetSdk=1 处理，App 会被塞进
         屏幕兼容模式（COMPATIBLE_WINDOW，320dp 小窗口拉伸到全屏），
         表现为 UI 整体放大 2~3 倍、WebView CSS 视口只剩 ~125px、点击坐标错位。 -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <application
        android:allowBackup="true"
        android:label="B站集锦播放器"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.BiliHl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统分享面板里选本应用（B 站「分享」→ 复制链接/分享到此） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 深度链接：直接点开 B 站视频链接时调起本应用 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="https" android:host="bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="https" android:host="m.bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="http" android:host="www.bilibili.com" android:pathPrefix="/video/" />
                <data android:scheme="https" android:host="b23.tv" />
            </intent-filter>
        </activity>
    </application>

</manifest>
